{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learning-side-kick",
  "version": "0.1.0",
  "identifier": "com.szymon.learning-side-kick",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "learning-side-kick",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["models/ggml-small.bin"],
    "windows": {
      "allowDowngrades": true,
      "bundleVCRuntime": false,
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "minimumWebview2Version": null,
      "nsis": null,
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    }
  }
}
